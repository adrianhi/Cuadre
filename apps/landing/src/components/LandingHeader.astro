---
const navItems = [
  { href: '/#proposito', label: 'Propósito' },
  { href: '/#como-funciona', label: 'Cómo funciona' },
  { href: '/calculadora-quincena', label: 'Calculadora' },
  { href: '/seguridad', label: 'Seguridad' },
  { href: '/#preguntas', label: 'Preguntas' },
];

const loginUrl = import.meta.env.PUBLIC_APP_LOGIN_URL || 'https://app.cuadre.com.do/login';
---

<header transition:persist="header" class="sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-xl pt-[env(safe-area-inset-top)] transition-colors">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 font-black text-white shadow-md shadow-emerald-500/20 group-hover:scale-105 transition-transform">
        C.
      </div>
      <div class="flex items-baseline gap-1.5">
        <span class="text-xl font-bold tracking-tight text-white">Cuadre</span>
        <span class="text-xs font-semibold text-emerald-400">Beta</span>
      </div>
    </a>

    <!-- Desktop Anchor Navigation -->
    <nav class="hidden md:flex items-center gap-6 text-xs font-medium text-slate-400">
      {navItems.map((item) => (
        <a href={item.href} class="hover:text-white transition-colors">
          {item.label}
        </a>
      ))}
    </nav>

    <!-- CTAs -->
    <div class="hidden md:flex items-center gap-3">
      <a
        href={loginUrl}
        class="inline-flex h-9 items-center justify-center rounded-xl border border-slate-800 bg-slate-900/80 px-3.5 text-xs font-semibold text-slate-200 hover:border-slate-700 hover:bg-slate-800 hover:text-white transition-all shadow-xs"
      >
        Iniciar Sesión
      </a>
      <a
        href="/#beta-waitlist"
        class="inline-flex h-9 items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 px-4 text-xs font-bold text-slate-950 shadow-md shadow-emerald-500/20 hover:from-emerald-400 hover:to-teal-400 transition-all"
      >
        <span>Solicitar Acceso</span>
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-xl border border-slate-800 bg-slate-900/80 text-slate-400 hover:text-white transition-colors"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg id="menu-icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      <svg id="menu-icon-close" class="h-5 w-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>

  <!-- Mobile dropdown menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-800/80 bg-slate-950 px-4 py-6 space-y-4">
    <nav class="flex flex-col space-y-3 text-sm font-medium text-slate-300">
      {navItems.map((item) => (
        <a href={item.href} class="mobile-nav-link hover:text-emerald-400 transition-colors py-1">
          {item.label}
        </a>
      ))}
    </nav>
    <div class="pt-4 border-t border-slate-800/80 flex flex-col gap-2.5">
      <a
        href={loginUrl}
        class="inline-flex h-10 items-center justify-center rounded-xl border border-slate-800 bg-slate-900/80 text-xs font-semibold text-slate-200 hover:bg-slate-800 transition-colors"
      >
        Iniciar Sesión
      </a>
      <a
        href="/#beta-waitlist"
        class="mobile-nav-link inline-flex h-10 items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-xs font-bold text-slate-950"
      >
        <span>Solicitar Acceso</span>
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</header>

<script>
  function initHeader() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (toggleBtn && mobileMenu && iconOpen && iconClose) {
      toggleBtn.onclick = () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
        mobileMenu.classList.toggle('hidden');
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
      };

      // Close mobile menu on anchor clicks
      document.querySelectorAll('.mobile-nav-link').forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
          toggleBtn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  }

  // Smooth scroll for anchor clicks on the same page
  function setupSmoothScroll() {
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement)?.closest('a');
      if (!target) return;
      const href = target.getAttribute('href');
      if (!href) return;

      const isHome = window.location.pathname === '/' || window.location.pathname === '';

      if (href.startsWith('/#') && isHome) {
        const id = href.slice(2);
        const element = document.getElementById(id);
        if (element) {
          e.preventDefault();
          element.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.pushState(null, '', `#${id}`);
        }
      } else if (href.startsWith('#')) {
        const id = href.slice(1);
        const element = document.getElementById(id);
        if (element) {
          e.preventDefault();
          element.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.pushState(null, '', href);
        }
      }
    });
  }

  // Run on initial load and on every View Transition navigation
  document.addEventListener('astro:page-load', () => {
    initHeader();
  });

  // Setup smooth scroll listener once globally
  if (typeof window !== 'undefined' && !(window as any).__cuadreSmoothScrollInit) {
    (window as any).__cuadreSmoothScrollInit = true;
    setupSmoothScroll();
  }
</script>
