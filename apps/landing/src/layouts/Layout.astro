---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  includeFaqSchema?: boolean;
}

const {
  title = 'Cuadre | Control de Gastos y Quincena con tus Bancos Dominicanos',
  description = 'Descubre cada mañana cuánto puedes gastar sin descuadrar tu quincena. Cuadre procesa tus avisos bancarios (BHD, Popular, Banreservas, Qik) vía Gmail de forma segura y privada.',
  canonical = new URL(Astro.url.pathname, 'https://cuadre.com.do').href,
  ogImage = 'https://cuadre.com.do/og-image.png',
  includeFaqSchema = false,
} = Astro.props;

const siteUrl = 'https://cuadre.com.do';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Cuadre',
  alternateName: ['Cuadre App', 'Cuadre Finanzas', 'Cuadre RD', 'Cuadre República Dominicana'],
  url: siteUrl,
  description: description,
  inLanguage: 'es-DO',
};

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cuadre',
  applicationCategory: 'FinanceApplication',
  applicationSubCategory: 'Personal Finance & Budgeting',
  operatingSystem: 'All (Web browser, PWA, iOS, Android)',
  url: siteUrl,
  image: `${siteUrl}/og-image.png`,
  screenshot: `${siteUrl}/og-image.png`,
  description: description,
  featureList: [
    'Margen Seguro Diario para gastos variables',
    'Lectura oficial de avisos bancarios vía Gmail (gmail.readonly)',
    'Soporte para Banco Popular, Banco BHD, Banreservas y Qik',
    'Reserva automática de compromisos fijos quincenales y mensuales',
    'Cero claves bancarias requeridas y sin capacidad de mover dinero',
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'DOP',
    priceValidUntil: '2027-12-31',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Cuadre',
    url: siteUrl,
    logo: `${siteUrl}/favicon-192x192.png`,
  },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Cuadre',
  url: siteUrl,
  logo: `${siteUrl}/favicon-192x192.png`,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'privacidad@cuadre.do',
    areaServed: 'DO',
    availableLanguage: 'Spanish',
  },
};
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primario -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="cuadre, finanzas personales, bancos dominicanos, bhd, popular, banreservas, qik, gastos quincena, margen diario, presupuesto rd, control de gastos republica dominicana" />
    <meta name="author" content="Cuadre" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cuadre - Control de Gastos y Quincena para Bancos Dominicanos" />
    <meta property="og:site_name" content="Cuadre" />
    <meta property="og:locale" content="es_DO" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Cuadre - Control de Gastos y Quincena para Bancos Dominicanos" />

    <!-- Theme & App icons -->
    <meta name="theme-color" content="#020617" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Cuadre" />

    <!-- Google Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Astro View Transitions for silky-smooth SPA navigation -->
    <ClientRouter />
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased min-h-screen flex flex-col justify-between selection:bg-emerald-500 selection:text-white">
    <slot />
  </body>
</html>
