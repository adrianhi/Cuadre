# ==============================================================================
# CUADRE - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Usa este archivo como referencia para:
#   1. Desarrollo local: copiar a `.env` y configurar valores locales o de staging.
#   2. Producción (Render / Railway / VPS): configurar en el panel de hosting.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración del Servidor y Proceso
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# En producción Render usar "all" para unificar Web, API y Workers en un solo proceso:
PROCESS_ROLE=all
WORKER_IDLE_DELAY_MS=60000
WORKER_BUSY_DELAY_MS=50
WORKER_ERROR_DELAY_MS=10000

# ------------------------------------------------------------------------------
# 2. URLs y Dominios Públicos
# ------------------------------------------------------------------------------
# Desarrollo Local:
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Producción (Reemplazar por tu dominio HTTPS):
# APP_URL=https://app.cuadre.com.do
# API_PUBLIC_URL=https://app.cuadre.com.do
# CORS_ORIGIN=https://app.cuadre.com.do,https://cuadre.com.do,https://www.cuadre.com.do

# ------------------------------------------------------------------------------
# 3. Supabase Auth & Cliente API
# (Obtenido en Supabase Dashboard -> Project Settings -> API)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Variables para el cliente web (Vite):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_APP_URL=http://localhost:5173

# Opcional: correo que reclamará transacciones huérfanas en el primer login
LEGACY_OWNER_EMAIL=owner@example.com

# ------------------------------------------------------------------------------
# 4. Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
# Desarrollo Local (Docker o PostgreSQL local):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bills_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bills_db?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bills_test?schema=public"

# Producción Supabase (Puerto 6543 con pgbouncer para la app, puerto 5432 directo para migraciones):
# DATABASE_URL="postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 5. Seguridad y Cifrado
# ------------------------------------------------------------------------------
# Clave AES-256-GCM de exactamente 32 bytes en base64 para tokens de correo e ingesta:
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INGESTION_ENCRYPTION_KEY=base64_encoded_32_byte_key

# Sal criptográfica para sellar auditoría y consentimientos legales (mínimo 32 caracteres):
# Generar con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LEGAL_AUDIT_SALT=replace_with_at_least_32_random_characters

# Secreto para el webhook de cron tick en POST /api/v1/internal/maintenance/tick:
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAINTENANCE_SECRET=replace_with_a_long_random_secret

# ------------------------------------------------------------------------------
# 6. Identidad Legal Dominicana (Leyes 172-13 y 358-05 - Requerido en Producción)
# ------------------------------------------------------------------------------
LEGAL_PROVIDER_NAME="Nombre del Titular o Razón Social"
LEGAL_PROVIDER_ID="001-0000000-0"
LEGAL_CONTACT_EMAIL=privacidad@cuadre.com.do
LEGAL_CONTACT_ADDRESS="Santo Domingo, República Dominicana"

# ------------------------------------------------------------------------------
# 7. Integración Google OAuth & Gmail Sync
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace_me
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/oauth/google/callback
GMAIL_INITIAL_SYNC_MONTHS=2
GMAIL_RECONCILE_INTERVAL_MINUTES=5
GMAIL_WATCH_RENEWAL_HOURS=24
GMAIL_SYNC_CONCURRENCY=4
GMAIL_BACKFILL_CONCURRENCY=2

# Opcional: Google Cloud Pub/Sub Push (solo si se activa en producción)
# GOOGLE_PUBSUB_TOPIC=projects/replace-me/topics/bills-gmail
# GOOGLE_PUBSUB_PUSH_AUDIENCE=https://app.cuadre.com.do/api/v1/webhooks/google/gmail
# GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=bills-gmail-push@replace-me.iam.gserviceaccount.com

# ------------------------------------------------------------------------------
# 8. Correo Proactivo & Notificaciones (Resend)
# ------------------------------------------------------------------------------
# En desarrollo usar "AUDIT" para registrar envíos en base de datos sin llamar a Resend.
# En producción usar "LIVE" para entrega real de correos.
EMAIL_DELIVERY_MODE=AUDIT
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Cuadre <notificaciones@mail.cuadre.com.do>
# Mínimo 32 caracteres para el token de desuscripción de emails:
EMAIL_UNSUBSCRIBE_SECRET=replace-with-at-least-32-random-characters
EMAIL_WEEKLY_DIGEST_ENABLED=false
EMAIL_IMMINENT_BILL_ENABLED=false
EMAIL_PRICE_HIKE_ENABLED=false
EMAIL_PACING_WARNING_ENABLED=false
EMAIL_PAYDAY_RITUAL_ENABLED=false
