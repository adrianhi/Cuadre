---
import Layout from '../../layouts/Layout.astro';
import LandingHeader from '../../components/LandingHeader.astro';
import LandingFooter from '../../components/LandingFooter.astro';
import { BetaWaitlistForm } from '../../components/BetaWaitlistForm';
import { supportedBanks, type SupportedBankProfile } from '../../data/supportedBanks';

export function getStaticPaths() {
  return supportedBanks.map((bank) => ({
    params: { bank: bank.slug },
    props: { bank },
  }));
}

interface Props {
  bank: SupportedBankProfile;
}

const { bank } = Astro.props;
const otherBanks = supportedBanks.filter((item) => item.slug !== bank.slug);
const pageUrl = `https://cuadre.com.do/bancos/${bank.slug}`;

const bankFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: bank.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: 'https://cuadre.com.do',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Bancos Dominicanos',
      item: 'https://cuadre.com.do#cobertura-bancaria',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: bank.name,
      item: pageUrl,
    },
  ],
};
---

<Layout
  title={bank.metaTitle}
  description={bank.metaDescription}
  canonical={pageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(bankFaqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <LandingHeader />

  <main class="relative overflow-hidden">
    <!-- Ambient gradient glow -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(16,185,129,0.14),rgba(255,255,255,0))] pointer-events-none"></div>

    <!-- Hero Section -->
    <section class="relative pt-12 pb-16 md:pt-20 md:pb-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <!-- Breadcrumb Navigation -->
        <nav class="flex items-center gap-2 text-xs font-medium text-slate-400 mb-8" aria-label="Breadcrumb">
          <a href="/" class="hover:text-emerald-400 transition-colors">Inicio</a>
          <span>/</span>
          <a href="/#cobertura-bancaria" class="hover:text-emerald-400 transition-colors">Bancos</a>
          <span>/</span>
          <span class="text-white font-semibold">{bank.name}</span>
        </nav>

        <div class="text-center max-w-3xl mx-auto">
          <!-- Bank Pill Badge -->
          <div class="inline-flex items-center gap-2 rounded-full border border-slate-700/80 bg-slate-900/80 px-4 py-1.5 text-xs font-semibold backdrop-blur-xs mb-6 shadow-sm">
            <span class="h-2.5 w-2.5 rounded-full" style={`background-color: ${bank.accentColor};`}></span>
            <span class="text-slate-200">{bank.heroBadge}</span>
          </div>

          <!-- Main Title -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white leading-[1.15]">
            Controla tus gastos de <br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-emerald-200 bg-clip-text text-transparent">
              {bank.name}
            </span> con Cuadre
          </h1>

          <p class="mt-5 text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
            {bank.overview}
          </p>

          <!-- Security note -->
          <div class="mt-4 flex items-center justify-center gap-2 text-xs text-slate-400">
            <svg class="h-4 w-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <span>Solo lectura vía Gmail oficial · Cero claves bancarias · Sin mover fondos</span>
          </div>

          <!-- Waitlist CTA -->
          <div class="mt-8 flex justify-center">
            <BetaWaitlistForm client:visible source={`LANDING_BANK_${bank.code}`} className="max-w-md" />
          </div>
        </div>
      </div>
    </section>

    <!-- Supported Instruments / Notification Details -->
    <section class="border-t border-slate-800/80 bg-slate-900/40 py-14 sm:py-18">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="rounded-3xl border border-slate-800 bg-gradient-to-b from-slate-900/80 via-slate-900/50 to-slate-950 p-6 sm:p-10 shadow-xl">
          <div class="grid gap-8 lg:grid-cols-12 items-center">
            <div class="lg:col-span-7 space-y-4">
              <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-emerald-400">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="14" x="2" y="5" rx="2"/>
                  <line x1="2" x2="22" y1="10" y2="10"/>
                </svg>
                <span>Compatibilidad técnica</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
                Notificaciones y productos soportados de {bank.name}
              </h2>
              <p class="text-sm text-slate-300 leading-relaxed">
                Cuadre está calibrado para interpretar de manera exacta la sintaxis de los avisos enviados por {bank.legalEntityName}, extrayendo únicamente monto, comercio y fecha.
              </p>

              <ul class="space-y-3 pt-2">
                {bank.supportedInstruments.map((instrument) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-300">
                    <svg class="h-4 w-4 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 6 9 17l-5-5"/>
                    </svg>
                    <span>{instrument}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="lg:col-span-5 rounded-2xl border border-slate-800 bg-slate-950/90 p-5 space-y-4 text-xs text-slate-300">
              <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <span class="font-bold text-white text-sm">Validación del canal</span>
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-bold text-emerald-400 border border-emerald-500/20">
                  Verificado
                </span>
              </div>

              <div>
                <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Remitente oficial de aviso</p>
                <p class="mt-1 font-mono text-emerald-300 text-xs bg-slate-900 border border-slate-800 px-2.5 py-1.5 rounded-lg break-all">
                  {bank.emailSender}
                </p>
              </div>

              <div class="space-y-2 text-slate-400 leading-relaxed text-[11px]">
                <p>✔ Solo procesamos correos provenientes de este remitente bancario oficial.</p>
                <p>✔ Los mensajes se procesan en memoria con cifrado AES-256 sin almacenar contenido de texto de correos.</p>
                <p>✔ Cero acceso a tu usuario de Internet Banking o claves secretas.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Bank Benefits Grid -->
    <section class="border-t border-slate-800/80 bg-slate-950 py-16 sm:py-20">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <p class="text-xs font-bold uppercase tracking-wider text-emerald-400">Beneficios clave</p>
          <h2 class="mt-2 text-2xl sm:text-3xl font-black text-white tracking-tight">
            Por qué usar Cuadre con tu cuenta de {bank.name}
          </h2>
          <p class="mt-3 text-sm text-slate-400 leading-relaxed">
            Diseñado específicamente para resolver el descuadre de quincena en el contexto financiero dominicano.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          {bank.benefits.map((benefit, index) => (
            <div class="rounded-3xl border border-slate-800/80 bg-slate-900/60 p-6 sm:p-7 flex flex-col justify-between hover:border-emerald-500/40 hover:shadow-xl hover:shadow-emerald-950/20 transition-all">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-xs font-mono font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-lg border border-emerald-500/20">
                    0{index + 1}
                  </span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-white mb-2">
                  {benefit.title}
                </h3>
                <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                  {benefit.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Bank FAQ Section -->
    <section class="border-t border-slate-800/80 bg-slate-900/30 py-16 sm:py-20">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <p class="text-xs font-bold uppercase tracking-wider text-emerald-400">Preguntas frecuentes</p>
          <h2 class="mt-2 text-2xl sm:text-3xl font-black text-white tracking-tight">
            Dudas comunes sobre la integración con {bank.name}
          </h2>
        </div>

        <div class="space-y-4">
          {bank.faqs.map((faq) => (
            <div class="rounded-2xl border border-slate-800/80 bg-slate-900/70 p-5 sm:p-6">
              <h3 class="text-sm sm:text-base font-bold text-white mb-2 flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0">?</span>
                <span>{faq.question}</span>
              </h3>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed pl-5">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Other Dominican Banks (Internal Linking Cluster) -->
    <section class="border-t border-slate-800/80 bg-slate-950 py-14 sm:py-18">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-8">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Ecosistema multibanco en República Dominicana</p>
          <h3 class="mt-2 text-lg sm:text-xl font-bold text-white">
            ¿También usas otros bancos dominicanos?
          </h3>
          <p class="mt-2 text-xs text-slate-400">
            Cuadre consolida todos tus movimientos en un único Margen Diario unificado.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
          {otherBanks.map((item) => (
            <a
              href={`/bancos/${item.slug}`}
              class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5 hover:border-emerald-500/40 hover:bg-slate-900/80 transition-all group flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="h-2 w-2 rounded-full" style={`background-color: ${item.accentColor};`}></span>
                  <span class="text-xs font-bold text-slate-200 group-hover:text-emerald-400 transition-colors">
                    {item.name}
                  </span>
                </div>
                <p class="text-[11px] text-slate-400 line-clamp-2">
                  {item.tagline}
                </p>
              </div>
              <div class="mt-4 flex items-center text-xs font-semibold text-emerald-400 gap-1 group-hover:translate-x-0.5 transition-transform">
                <span>Ver integración</span>
                <span>→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Final Call to Action -->
    <section class="border-t border-slate-800/80 bg-gradient-to-b from-slate-900/60 to-slate-950 py-16 text-center">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          Prueba Cuadre gratis con tu cuenta de {bank.name}
        </h2>
        <p class="mt-3 text-sm text-slate-400 max-w-xl mx-auto">
          Acceso completo a la beta privada durante 30 días. Sin tarjetas de crédito para registrarte.
        </p>
        <div class="mt-6 flex justify-center">
          <BetaWaitlistForm client:visible source={`LANDING_BANK_FOOTER_${bank.code}`} className="max-w-md" />
        </div>
      </div>
    </section>
  </main>

  <LandingFooter />
</Layout>
