---
import Layout from '../layouts/Layout.astro';
import LandingHeader from '../components/LandingHeader.astro';
import LandingFooter from '../components/LandingFooter.astro';
import { BetaWaitlistForm } from '../components/BetaWaitlistForm';

const pageTitle = 'Seguridad y Privacidad Bancaria | Modo Solo Lectura • Cuadre';
const pageDescription = 'Conoce los estándares de seguridad de Cuadre: conexión en modo solo lectura auditada por Google API, sin acceso a credenciales bancarias, sin tarjetas y con eliminación de datos en 1 clic.';

const securityFaqs = [
  {
    question: '¿Cuadre me solicitará la contraseña de mi banco o PIN de tarjeta?',
    answer: 'No. Jamás te solicitaremos contraseñas de Internet Banking, PIN de tarjetas de débito o crédito, ni códigos de token o tarjeta de claves. La sincronización se realiza de manera 100% externa mediante la lectura pasiva de las notificaciones que tu banco ya te envía por correo electrónico.',
  },
  {
    question: '¿Puede Cuadre realizar transferencias o cargos a mi cuenta bancaria?',
    answer: 'Técnicamente imposible. Cuadre no cuenta con integración transaccional con ningún sistema bancario. Es una plataforma de cálculo financiero informativo y no tiene capacidad para debitar, transferir ni mover fondos de tus cuentas.',
  },
  {
    question: '¿Qué correos lee Cuadre de mi bandeja de entrada de Gmail?',
    answer: 'Cuadre filtra de manera estricta y automática únicamente los mensajes provenientes de los remitentes oficiales de avisos bancarios (ejemplo: avisos@popularenlinea.com, alertas@bhd.com.do, TuBanco@banreservas.com.do, notificaciones@qik.com.do). Ningún correo personal, laboral o familiar es procesado ni almacenado.',
  },
  {
    question: '¿Qué es la política de "Limited Use" de Google Workspace?',
    answer: 'El uso que hace Cuadre de la información recibida a través de las APIs de Google se adhiere a la Política de Datos de Usuario de Google API Services, incluidos los estrictos requisitos de Uso Limitado (Limited Use). Esto prohíbe explícitamente vender datos a terceros o utilizarlos para publicidad dirigida.',
  },
  {
    question: '¿Cómo puedo desvincular mi cuenta o eliminar mis datos?',
    answer: 'Puedes desvincular el acceso a tu cuenta de Google en cualquier momento con un solo clic desde tu panel de configuración o directamente desde la administración de seguridad de tu cuenta de Google. Al solicitar la eliminación de cuenta, todos tus registros de transacciones y perfiles son purgados de forma irreversible conforme a la Ley No. 172-13 de República Dominicana.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: pageTitle,
      url: 'https://cuadre.com.do/seguridad',
      description: pageDescription,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://cuadre.com.do/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Seguridad y Privacidad',
          item: 'https://cuadre.com.do/seguridad',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: securityFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://cuadre.com.do/seguridad"
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <LandingHeader />

  <main class="relative z-10 pb-20">
    {/* Breadcrumbs */}
    <div class="mx-auto max-w-5xl px-4 pt-8 sm:px-6">
      <nav class="flex items-center gap-2 text-xs text-slate-400">
        <a href="/" class="hover:text-emerald-400 transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-emerald-400 font-medium">Seguridad y Privacidad</span>
      </nav>
    </div>

    {/* Hero Section */}
    <section class="mx-auto max-w-5xl px-4 pt-8 pb-12 sm:px-6 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-medium text-emerald-300 backdrop-blur-xs mb-4">
        <svg class="h-3.5 w-3.5 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>Arquitectura de Privacidad por Diseño (Zero-Credential Access)</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight max-w-3xl leading-tight">
        Tu tranquilidad financiera{' '}
        <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-emerald-200 bg-clip-text text-transparent">
          empieza por la seguridad
        </span>
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
        Diseñamos Cuadre bajo un principio inquebrantable: <strong>tu banco se queda en tu banco</strong>. Procesamos notificaciones vía Google API sin pedir jamás tus contraseñas bancarias ni números de tarjeta.
      </p>
    </section>

    {/* The 4 Security Pillars */}
    <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {/* Pillar 1 */}
        <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 space-y-3 relative overflow-hidden">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="m7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h2 class="text-lg font-bold text-white tracking-tight">1. Cero credenciales ni contraseñas bancarias</h2>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            A diferencia de aplicaciones tradicionales que te exigen introducir tu usuario y contraseña de Internet Banking, Cuadre no interactúa con tu cuenta bancaria. Nunca te pediremos credenciales, preguntas secretas ni códigos de tokens físicos o virtuales.
          </p>
        </div>

        {/* Pillar 2 */}
        <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 space-y-3 relative overflow-hidden">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-500/10 text-teal-400 border border-teal-500/20">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h2 class="text-lg font-bold text-white tracking-tight">2. Imposibilidad técnica de realizar cargos o débitos</h2>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            Cuadre es una herramienta de cálculo y visualización. No posee ninguna interfaz operativa para enviar dinero, debitar balances o cobrar mensualidades. Tus fondos permanecen 100% bajo tu custodia y la de tus bancos dominicanos autorizados.
          </p>
        </div>

        {/* Pillar 3 */}
        <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 space-y-3 relative overflow-hidden">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
          </div>
          <h2 class="text-lg font-bold text-white tracking-tight">3. Modo de solo lectura vía Google API (Limited Use)</h2>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            Nos conectamos mediante OAuth 2.0 oficial de Google en modo de solo lectura restringida. Un filtro algorítmico selecciona únicamente los correos provenientes de avisos bancarios dominicanos y descarta cualquier otro correo sin leerlo ni almacenarlo.
          </p>
        </div>

        {/* Pillar 4 */}
        <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 space-y-3 relative overflow-hidden">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          </div>
          <h2 class="text-lg font-bold text-white tracking-tight">4. Desconexión en 1 clic y eliminación permanente</h2>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            Eres el único dueño de tus datos. En cualquier momento puedes revocar el acceso desde tu cuenta de Google o solicitar la eliminación total de tu perfil desde el panel de usuario, purgando tus registros conforme a la Ley No. 172-13 de República Dominicana.
          </p>
        </div>
      </div>
    </section>

    {/* Verification Badges Section */}
    <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 border-t border-slate-800/80">
      <div class="rounded-2xl border border-slate-800/80 bg-slate-950/60 p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-1 text-center md:text-left">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Cumplimiento Legal y Auditoría</span>
          <h3 class="text-lg sm:text-xl font-bold text-white">Transparencia y Políticas Públicas</h3>
          <p class="text-xs text-slate-400 max-w-xl">
            Revisa en detalle nuestros compromisos contractuales, la política de uso de datos y los términos de servicio vigentes.
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/legal/privacy"
            class="px-4 py-2 rounded-xl border border-slate-800 bg-slate-900/80 text-xs font-semibold text-slate-200 hover:text-white hover:border-slate-700 transition-colors"
          >
            Política de Privacidad
          </a>
          <a
            href="/legal/google-api-disclosure"
            class="px-4 py-2 rounded-xl border border-slate-800 bg-slate-900/80 text-xs font-semibold text-slate-200 hover:text-white hover:border-slate-700 transition-colors"
          >
            Divulgación Google API
          </a>
          <a
            href="/legal/data-deletion"
            class="px-4 py-2 rounded-xl border border-slate-800 bg-slate-900/80 text-xs font-semibold text-slate-200 hover:text-white hover:border-slate-700 transition-colors"
          >
            Eliminación de Datos
          </a>
        </div>
      </div>
    </section>

    {/* FAQ Section */}
    <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 border-t border-slate-800/80">
      <div class="text-center sm:text-left mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Dudas Frecuentes</span>
        <h2 class="text-2xl font-bold text-white tracking-tight mt-1">
          Preguntas sobre privacidad y seguridad bancaria
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {securityFaqs.map((faq) => (
          <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5 space-y-2">
            <h3 class="text-sm font-semibold text-white">{faq.question}</h3>
            <p class="text-xs text-slate-400 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    {/* CTA */}
    <section class="mx-auto max-w-5xl px-4 pt-12 sm:px-6">
      <div class="rounded-3xl border border-emerald-500/30 bg-gradient-to-b from-slate-900/90 to-slate-950 p-8 sm:p-12 text-center shadow-2xl relative overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(16,185,129,0.15),transparent_70%)] pointer-events-none"></div>
        <div class="relative z-10 max-w-xl mx-auto">
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Controla tu quincena con total serenidad
          </h2>
          <p class="mt-3 text-sm text-slate-300 leading-relaxed">
            Sin tarjetas bancarias, sin comprometer tus contraseñas y con 30 días de acceso completo durante la beta privada.
          </p>
          <div class="mt-6 flex justify-center">
            <BetaWaitlistForm client:visible source="SEGURIDAD_PAGE" className="max-w-md" />
          </div>
        </div>
      </div>
    </section>
  </main>

  <LandingFooter />
</Layout>
