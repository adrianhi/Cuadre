---
import Layout from '../layouts/Layout.astro';
import LandingHeader from '../components/LandingHeader.astro';
import LandingFooter from '../components/LandingFooter.astro';
---

<Layout title="Página no encontrada • Cuadre" description="La página que buscas no existe o ha sido movida.">
  <LandingHeader />
  <main class="min-h-[60vh] flex items-center justify-center px-4 py-16 text-center">
    <div class="max-w-md space-y-4">
      <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-500/10 text-emerald-400 font-black text-2xl">
        404
      </div>
      <h1 class="text-3xl font-black text-white">Página no encontrada</h1>
      <p class="text-sm text-slate-400 leading-relaxed">
        El enlace que intentas abrir no existe o ha cambiado de ubicación.
      </p>
      <div class="pt-4">
        <a
          href="/"
          class="inline-flex h-10 items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 px-5 text-xs font-bold text-slate-950"
        >
          Volver a Cuadre
        </a>
      </div>
    </div>
  </main>
  <LandingFooter />
</Layout>
